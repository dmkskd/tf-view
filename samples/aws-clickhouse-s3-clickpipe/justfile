# aws-clickhouse-s3-clickpipe: real AWS + ClickHouse Cloud. apply and destroy cost money.
#
# AWS credentials: the default chain (~/.aws/credentials, env, SSO).
# ClickHouse credentials: CLICKHOUSE_ORG_ID, CLICKHOUSE_CLOUD_API_KEY and
# CLICKHOUSE_CLOUD_API_SECRET, from the environment or from a
# .clickhouse.env file in this directory or any parent, e.g. ~/.clickhouse.env.

set shell := ["bash", "-cu"]
set dotenv-filename := ".clickhouse.env"

default:
    @just --list --unsorted

# Install providers
init:
    terraform init

# Plan against the real accounts (read-only)
plan *args:
    terraform plan -input=false -out=tfplan {{args}}

# Write plan.json from a fresh plan, for tfplanview
json *args: (plan args)
    terraform show -json tfplan > plan.json

# LLM review of plan.json (run just json first): plan-reviewed.json and review.html. Model: model= or TFVIEW_MODEL
explain model="" scope="changes":
    tfview explain plan.json {{ if model != "" { "--model " + model } else { "" } }} --scope {{scope}} --json-out plan-reviewed.json -o review.html

# Create the stack. Run: just apply confirm
apply confirm *args:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ "{{confirm}}" != "confirm" ]; then
      echo "Creates billable AWS and ClickHouse Cloud resources. Run: just apply confirm" >&2
      exit 1
    fi
    terraform apply {{args}}

# Upload one JSON file with n events from the EC2 client to S3
produce-s3 n="100":
    #!/usr/bin/env bash
    set -euo pipefail
    bucket=$(terraform output -raw events_bucket)
    ./ssm.sh <<SCRIPT
    set -e
    f=/tmp/events-\$(date -u +%Y%m%dT%H%M%S).json
    python3 - "{{n}}" > "\$f" <<'PY'
    import json, random, sys, uuid, datetime
    types = ["page_view", "click", "signup", "purchase"]
    for _ in range(int(sys.argv[1])):
        print(json.dumps({
            "id": str(uuid.uuid4()),
            "ts": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%M:%S.%f")[:-3],
            "event_type": random.choice(types),
            "user_id": random.randint(1, 1000),
            "value": round(random.uniform(0, 100), 2),
        }))
    PY
    aws s3 cp --no-progress "\$f" "s3://$bucket/events/\$(basename \$f)"
    SCRIPT

# Query the events table from the EC2 client over PrivateLink
check-s3:
    #!/usr/bin/env bash
    set -euo pipefail
    host=$(terraform output -raw clickhouse_host)
    password=$(terraform output -raw clickhouse_password)
    ./ssm.sh <<SCRIPT
    q() { curl -sS --fail-with-body --user 'default:$password' "https://$host:8443/" --data-binary "\$1"; }
    q "SELECT count() AS rows, max(ts) AS latest FROM events FORMAT PrettyCompactMonoBlock"
    q "SELECT event_type, count() AS n, round(avg(value), 2) AS avg_value FROM events GROUP BY event_type ORDER BY n DESC FORMAT PrettyCompactMonoBlock"
    SCRIPT

# Create pg_orders_live in ClickHouse: a PostgreSQL engine table, each query reads Postgres
pg-link:
    #!/usr/bin/env bash
    set -euo pipefail
    host=$(terraform output -raw clickhouse_host)
    password=$(terraform output -raw clickhouse_password)
    pg_host=$(terraform output -raw pg_host)
    pg_user=$(terraform output -raw pg_user)
    pg_password=$(terraform output -raw pg_password)
    # the PostgreSQL engine has no LowCardinality
    cols="id Int64, created_at DateTime64(6, 'UTC'), customer_id Int32, status String, amount Decimal(10, 2)"
    ./ssm.sh <<SCRIPT
    set -e
    curl -sS --fail-with-body --user 'default:$password' "https://$host:8443/" \
      --data-binary "CREATE TABLE IF NOT EXISTS pg_orders_live ($cols) ENGINE = PostgreSQL('$pg_host:5432', 'postgres', 'orders', '$pg_user', '$pg_password', 'public')"
    echo linked
    SCRIPT

# Insert n orders into Postgres from the EC2 client, and ship 10 paid ones
produce-pg n="100":
    #!/usr/bin/env bash
    set -euo pipefail
    pg_host=$(terraform output -raw pg_host)
    pg_user=$(terraform output -raw pg_user)
    pg_password=$(terraform output -raw pg_password)
    ./ssm.sh <<SCRIPT
    set -e
    command -v psql >/dev/null || dnf install -y -q postgresql16
    export PGPASSWORD='$pg_password'
    psql "host=$pg_host user=$pg_user dbname=postgres sslmode=require" -v ON_ERROR_STOP=1 \
      -c "INSERT INTO orders (customer_id, status, amount) SELECT 1 + floor(random() * 1000)::int, (ARRAY['new', 'paid', 'shipped'])[1 + floor(random() * 3)::int], round((random() * 200)::numeric, 2) FROM generate_series(1, {{n}})" \
      -c "UPDATE orders SET status = 'shipped' WHERE id IN (SELECT id FROM orders WHERE status = 'paid' ORDER BY random() LIMIT 10)"
    SCRIPT

# Compare Postgres (through pg_orders_live) with the CDC copy in pg_orders_cdc
check-pg:
    #!/usr/bin/env bash
    set -euo pipefail
    host=$(terraform output -raw clickhouse_host)
    password=$(terraform output -raw clickhouse_password)
    ./ssm.sh <<SCRIPT
    q() { curl -sS --fail-with-body --user 'default:$password' "https://$host:8443/" --data-binary "\$1"; }
    if [ "\$(q 'EXISTS TABLE pg_orders_cdc')" != 1 ]; then
      echo "no pg_orders_cdc yet: the pipe creates it, see just state"; exit 0
    fi
    q "SELECT 'postgres' AS src, count() AS rows, countIf(status = 'shipped') AS shipped, max(created_at) AS latest, NULL AS synced FROM pg_orders_live
       UNION ALL
       SELECT 'clickhouse', count(), countIf(status = 'shipped'), max(created_at), max(_peerdb_synced_at) FROM pg_orders_cdc FINAL WHERE _peerdb_is_deleted = 0
       FORMAT PrettyCompactMonoBlock"
    SCRIPT

# ClickPipe states as reported by ClickHouse Cloud
state:
    terraform apply -refresh-only -auto-approve -target=clickhouse_clickpipe.events -target=clickhouse_clickpipe.orders >/dev/null
    @echo "events: $(terraform output -raw clickpipe_state)"
    @echo "orders: $(terraform output -json pg_clickpipe_state)"

# Delete everything. Run: just destroy confirm
destroy confirm *args:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ "{{confirm}}" != "confirm" ]; then
      echo "Deletes the AWS and ClickHouse Cloud resources. Run: just destroy confirm" >&2
      exit 1
    fi
    terraform destroy {{args}}
