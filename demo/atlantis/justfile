set shell := ["bash", "-cu"]

default:
    @just --list

# Build the viewer if needed, start everything and follow the one-time GitLab setup
up:
    [ -f ../../dist/index.html ] || just --justfile ../../justfile --working-directory ../.. build
    docker compose up -d --build
    docker compose logs -f setup

# Open a demo merge request. mode: add (creates), or change (update + replace + destroy, after add is applied and merged)
demo mode="add":
    docker compose run --rm --build demo {{mode}}

logs service="atlantis":
    docker compose logs -f {{service}}

# Stop everything and delete GitLab's data
reset:
    docker compose down -v
