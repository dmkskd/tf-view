# ClickHouse demo: a PR on real AWS + ClickHouse Cloud, planned by a local Atlantis.
# Reuses the GitHub demo's scripts (../github/scripts) with this folder's .env and the stack in ../shared-clickhouse.
set shell := ["bash", "-cu"]
set dotenv-load

# empty without .env, so `just` still lists the recipes; the recipes that need them stop with a message
export GH_USER := `r="${GH_REPO:-}"; echo "${r%%/*}"`
export REPORTS_URL := `r="${GH_REPO:-}"; [ -n "$r" ] && echo "https://${r%%/*}.github.io/${r##*/}/reports" || true`
export DEMO_DIR := justfile_directory()
export SHARED := "../shared-clickhouse"
export SEED_MESSAGE := "Base stack: VPC, EC2 client, S3 ClickPipe, ClickHouse service over PrivateLink"
scripts := "../github/scripts"

default:
    @just --list --unsorted

[private]
need-env:
    #!/usr/bin/env bash
    [ -f .env ] || { echo "No .env here: cp .env.example .env and fill it in (see README.md)" >&2; exit 1; }
    for v in GH_REPO GH_TOKEN GH_WEBHOOK_SECRET SMEE_URL; do
      [ -n "${!v:-}" ] || { echo "$v is empty in .env" >&2; exit 1; }
    done

# Push the stack to the repo's main branch and set up GitHub Pages (safe to re-run)
seed: need-env
    {{scripts}}/seed.sh

# Apply the base stack for real into the state volume (billable). Run: just base confirm
base confirm:
    #!/usr/bin/env bash
    set -euo pipefail
    [ "{{confirm}}" = confirm ] || { echo "Creates billable AWS and ClickHouse Cloud resources. Run: just base confirm" >&2; exit 1; }
    docker compose run --rm base apply

# Plan the base stack against the state volume (read-only)
base-plan:
    docker compose run --rm base plan -input=false

# Sync the stack to the repo, point its webhook at the relay, start Atlantis and print READY
up: need-env
    #!/usr/bin/env bash
    set -euo pipefail
    [ -f ../../../dist/index.html ] || just --justfile ../../../justfile --working-directory ../../.. build
    {{scripts}}/seed.sh
    docker compose up -d --build atlantis relay
    {{scripts}}/webhook.sh on
    echo "waiting for Atlantis..."
    for i in $(seq 1 60); do curl -fs -o /dev/null http://127.0.0.1:4143/healthz && break; sleep 2; done
    curl -fs -o /dev/null http://127.0.0.1:4143/healthz || { echo "Atlantis did not start: just logs"; exit 1; }
    echo ""; echo "READY: Atlantis listens for ${GH_REPO} through ${SMEE_URL}"
    echo "Next: just mr-create"

# Remove the webhook and stop Atlantis (the base stack and its state stay)
down:
    {{scripts}}/webhook.sh off || true
    docker compose down

# Open the PR: the writer idles after 15 minutes instead of 5 (update; one service, no warehouse box yet)
mr-create: need-env
    {{scripts}}/demo.sh mr-create

# Change 1: a read-only reporting service on the warehouse (creates; the warehouse box appears)
mr-change-1: need-env
    {{scripts}}/demo.sh mr-change-1

# Change 2: scale the writer from 3 to 2 replicas (update)
mr-change-2: need-env
    {{scripts}}/demo.sh mr-change-2

# Change 3: EC2 client from t4g.micro to t4g.small (update)
mr-change-3: need-env
    {{scripts}}/demo.sh mr-change-3

# Change 4: the events ClickPipe sorts its table by ts only (replace)
mr-change-4: need-env
    {{scripts}}/demo.sh mr-change-4

# Change 5: remove the seed file (delete)
mr-change-5: need-env
    {{scripts}}/demo.sh mr-change-5

# The whole PR: open it, then changes 1 to 5, each pushed once Atlantis has posted the plan of the previous one
demo: need-env
    #!/usr/bin/env bash
    set -euo pipefail
    now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
    # waits for Atlantis's plan comment on PR $1 posted after $2 (up to 15 min); a plan refused because
    # another plan still holds the PR is asked for again
    wait_plan() {
      for _ in $(seq 1 90); do
        b=$(gh api "repos/${GH_REPO}/issues/$1/comments?since=$2" --jq '.[].body' 2>/dev/null || true)
        if grep -q 'is currently locked' <<<"$b"; then
          sleep 20; gh pr comment "$1" -R "${GH_REPO}" --body "atlantis plan" >/dev/null; set -- "$1" "$(now)"
          echo "  plan refused (another plan was running); asked again"; continue
        fi
        if grep -q '^Ran Plan' <<<"$b"; then echo "  Atlantis planned #$1"; return 0; fi
        sleep 10
      done
      echo "no plan from Atlantis on #$1 after 15 min (a dropped relay event? comment 'atlantis plan' on the PR)"; return 1
    }
    t=$(now); just mr-create
    pr=$(gh api "repos/${GH_REPO}/pulls?state=open&sort=created&direction=desc&per_page=30" \
           --jq '[.[] | select(.head.ref | startswith("demo-"))][0].number')
    wait_plan "$pr" "$t"
    for n in 1 2 3 4 5; do
      t=$(now); just mr-change-$n
      wait_plan "$pr" "$t"
    done
    echo "Done: https://github.com/${GH_REPO}/pull/$pr"

# A showcase PR: a new demo PR (or the open one, `pr`) with all five changes, then the plan once per image setting (PNG, SVG tour, sections, replay, still, no HTML)
showcase pr="": need-env
    ATLANTIS_URL=http://127.0.0.1:4143 SHOWCASE_CHANGES="1 2 3 4 5" {{scripts}}/showcase.sh {{trim_start_match(pr, "pr=")}}

# Show the open PR and its commits
status: need-env
    {{scripts}}/demo.sh status

# Atlantis logs
logs:
    docker compose logs -f atlantis

# Destroy the base stack (and anything a PR applied). Run: just destroy confirm
destroy confirm:
    #!/usr/bin/env bash
    set -euo pipefail
    [ "{{confirm}}" = confirm ] || { echo "Deletes the AWS and ClickHouse Cloud resources. Run: just destroy confirm" >&2; exit 1; }
    docker compose run --rm base destroy
