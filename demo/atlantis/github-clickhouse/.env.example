# Copy to .env (git-ignored) and fill in. Never commit the real one.
# Use a different repo and relay channel from the Floci demo in ../github.
GH_REPO=OWNER/tf-view-clickhouse-demo   # the demo repo; a private repo keeps account IDs and hostnames off the web
GH_TOKEN=                               # fine-grained token for that repo only (contents, pull requests, issues, commit statuses)
GH_WEBHOOK_SECRET=                      # openssl rand -hex 20
SMEE_URL=                               # webhook relay channel: curl -sI https://smee.io/new | grep -i ^location

# Optional LLM review, as in ../github/.env.example
TFVIEW_LLM=false
TFVIEW_MODEL=
TFVIEW_ENDPOINT=
TFVIEW_API_KEY=
TFVIEW_TEMPERATURE=0
