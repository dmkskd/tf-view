# Copy to .env (git-ignored) and fill in. Never commit the real one.
GH_REPO=OWNER/tf-view-demo       # the public demo repo
GH_TOKEN=                        # fine-grained token for that repo only (contents, pull requests, issues, commit statuses)
GH_WEBHOOK_SECRET=               # openssl rand -hex 20
SMEE_URL=                        # webhook relay channel: curl -sI https://smee.io/new | grep -i ^location

# Optional: an LLM review in each report. False unless TFVIEW_LLM=true.
# Ollama running on this machine (outside Docker; on Linux start it with OLLAMA_HOST=0.0.0.0):
TFVIEW_LLM=false                 # true = add the review
TFVIEW_MODEL=                    # e.g. ollama::qwen2.5:7b  (a hosted model also needs TFVIEW_API_KEY)
TFVIEW_ENDPOINT=                 # e.g. http://host.docker.internal:11434
TFVIEW_API_KEY=
TFVIEW_TEMPERATURE=0             # 0 to 2; 0 is the steadiest (same plan, same rating)
